{
  "name": "courtplus",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run -ws --if-present build",
    "pretest": "npm run build -w @courtplus/contracts -w @courtplus/engine -w @courtplus/intake -w @courtplus/export",
    "test": "npm run -ws --if-present test",
    "lint": "npm run -ws --if-present lint"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}

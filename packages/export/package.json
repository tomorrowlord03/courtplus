{
  "name": "@courtplus/export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "default": "./dist/signing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-resources.mjs",
    "test": "vitest run",
    "samples": "node --experimental-strip-types tests/samples.mjs"
  },
  "dependencies": {
    "@courtplus/contracts": "0.0.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "canonicalize": "2.1.0",
    "exceljs": "4.4.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "pngjs": "^7.0.0"
  }
}
